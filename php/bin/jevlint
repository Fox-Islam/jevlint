#!/usr/bin/env php
<?php

declare(strict_types=1);

use Phox\JevLint\Console\Application;

foreach ([__DIR__.'/../../vendor/autoload.php', __DIR__.'/../../../../autoload.php'] as $autoload) {
    if (is_file($autoload)) {
        require $autoload;

        break;
    }
}

if (! class_exists(Application::class)) {
    fwrite(STDERR, 'Run `composer install` in the repository root first.'.PHP_EOL);

    exit(2);
}

exit((new Application())->run($argv));
