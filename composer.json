{
    "name": "phox/jevlint",
    "description": "A linting tool combining static analysis and Jev queries, to improve Jev queries",
    "type": "library",
    "license": "MIT",
    "homepage": "https://fox-islam.github.io/jevlint/",
    "support": {
        "issues": "https://github.com/Fox-Islam/jevlint/issues",
        "source": "https://github.com/Fox-Islam/jevlint"
    },
    "keywords": [
        "typesafe",
        "jev",
        "linter",
        "prompt",
        "system-one"
    ],
    "authors": [
        {
            "name": "Fox Islam",
            "email": "foxislam@outlook.com"
        }
    ],
    "bin": [
        "php/bin/jevlint"
    ],
    "autoload": {
        "psr-4": {
            "Phox\\JevLint\\": "php/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Phox\\JevLint\\Tests\\": "php/tests/"
        }
    },
    "require": {
        "php": "^8.3",
        "ext-intl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "phox/typesafe-sdk-php": "^0.4"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^11.5"
    },
    "scripts": {
        "phpstan": "phpstan analyse -c phpstan.neon",
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
